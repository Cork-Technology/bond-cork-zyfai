# Node environment (development | production | test)
NODE_ENV=development

# HTTP port if the bond keeper exposes a small health/quote server (optional)
PORT=4000

# Log level for pino (trace | debug | info | warn | error | fatal)
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Chain connection
# ---------------------------------------------------------------------------
# Arbitrum One HTTP RPC endpoint (Alchemy, Infura, or any other provider).
RPC_URL=https://arb-mainnet.g.alchemy.com/v2/xxxxxxxxxxxxxxxxxxxx

# Cork Phoenix API base URL (order book + indexer)
CORK_API_URL=https://api-phoenix.cork.tech

# ---------------------------------------------------------------------------
# Bond signer
# ---------------------------------------------------------------------------
# Bond underwriting bot EOA private key.
# 0x-prefixed 32-byte hex (64 hex chars). HACKATHON KEY ONLY — never reuse.
# Replace the placeholder below with a real funded EOA key.
BOND_EOA_PRIVATE_KEY=0x1111111111111111111111111111111111111111111111111111111111111111

# ---------------------------------------------------------------------------
# Live contract addresses — Arbitrum One shadow Phoenix
# Sources of truth: .claude/skills/cork-operations/references/addresses.md
# ---------------------------------------------------------------------------
CORK_MARKET_CREATOR=0x4B5B91cF4d1DAdb7439beB68926c86D2D8C68dBC
FIXED_RATE_ORACLE_FACTORY=0x1050e67e37447e0D5686B3ee972a2c6dDB433295
CORK_LIMIT_ORDER_ADAPTER=0xc915B0776189E5Fa021C60D76Da0c8D7F1997801
ONE_INCH_LOP_V4=0x111111125421cA6dc452d289314280a0f8842A65

CORK_POOL_MANAGER=0xc2De56fb1C7a85250ce69C37B4773767C77954AE
DEFAULT_CORK_CONTROLLER=0x8974fF6ef0eFCc143C01C6A596b026FdEB9Ff350
CORK_ADAPTER=0x5989761D6a567C16480Bc5ce2989492777532646
WHITELIST_MANAGER=0x6611676F84A25914Ce4A4B7866739E5cb70eAf42
CONSTRAINT_RATE_ADAPTER=0x798CB4Bd8066BAeF149Cf89aED71507B334bF20E
SHARES_FACTORY=0x48d8e4dE8731C3583ddA7Aa617a88C7F484AeB8e

# ---------------------------------------------------------------------------
# Market / asset configuration for the pilot
# ---------------------------------------------------------------------------
# Collateral asset (the premium currency and the asset the adapter pulls).
CA_TOKEN=0xaf88d065e77c8cC2239327C5EDb3A432268e5831
CA_DECIMALS=6

# Reference asset (the position being protected; e.g. a yield-bearing vault token).
REF_TOKEN=0x0000000000000000000000000000000000000000
REF_DECIMALS=18

# ---------------------------------------------------------------------------
# Counterparty / discovery helpers
# ---------------------------------------------------------------------------
# Demand-side bid maker address.
# Simple MVP path: the EOA that posted the opening bid (often the Zyfai shared EOA).
# Safe path (advanced): the Zyfai Safe smart-wallet address.
DEMAND_MAKER_ADDRESS=0x0000000000000000000000000000000000000000

# ---------------------------------------------------------------------------
# Pricing / risk settings (basis points, 10000 = 100%)
# ---------------------------------------------------------------------------
# Minimum annualized premium the model will accept for a 24h cover slice.
FLOOR_PREMIUM_BPS=50

# Mark-up added to the floor when countering (path B).
COUNTER_MARGIN_BPS=10

# Maximum CA the agent is willing to have locked in open orders / JIT fills.
MAX_CA_POSITION=1000000000

# How long negotiation orders rest on the book (seconds). Keep short.
ORDER_LIFETIME_SECONDS=600

# Default swap/unwind fees to assume when pricing (1e18 = 1%).
DEFAULT_SWAP_FEE_BPS=100
DEFAULT_UNWIND_SWAP_FEE_BPS=200
